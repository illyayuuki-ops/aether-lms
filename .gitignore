# Dependencies
node_modules/

# Build output
*.tsbuildinfo
scripts/dist/
artifacts/api-server/dist/
artifacts/library-system/dist/
artifacts/kiosk-electron/release/
build-log.txt
*.blockmap

# Built frontend copied into the API server (regenerated by `pnpm build:server`)
artifacts/api-server/public/

# Generated code + type output (regenerated by `pnpm codegen` / `tsc --build`)
lib/*/dist/

# Electron binary cache that must never be committed
artifacts/kiosk-electron/electron-extracted/

# Environment / secrets
.env
.env.*
!.env.example
artifacts/api-server/.env

# Runtime state
system-settings.json
artifacts/api-server/system-settings.json
*.log

# ── Database dumps / exports ─────────────────────────────────────────────────
# These contain real student names, IDs and (historically) passwords.
# Never commit them. Keep exports outside the repo, or under a folder that is
# explicitly ignored here.
*.sql
*.dump
*.pgsql
*.sql.gz
# ...but Drizzle migrations and seed fixtures ARE source and must be committed.
!lib/db/drizzle/*.sql
!/scripts/fixtures/*.sql
