STEP 2: Fix Ctrl+R reload (around line 284):
CHANGE FROM:
```javascript
  globalShortcut.register("Control+R", () => {
    if (mainWindow && !mainWindow.isDestroyed()) mainWindow.webContents.reload();
  });
```

TO:
```javascript
  globalShortcut.register("Control+R", () => {
    if (mainWindow && !mainWindow.isDestroyed()) {
      // Mark reload as intentional so unload handler doesn't logout
      mainWindow.webContents.executeJavaScript(`
        window.localStorage.setItem('kiosk_reload_in_progress', 'true');
      `).then(() => {
        mainWindow.webContents.reload();
      });
    }
  });
```

STEP 3: Update preload.js to expose safe name-setting:
Create/update artifacts/kiosk-electron/src/preload.js:
```javascript
const { contextBridge, ipcRenderer } = require('electron');

contextBridge.exposeInMainWorld('kioskBridge', {
  setSessionInfo: (name, computerNumber) => {
    ipcRenderer.invoke('set-badge-info', { name, computerNumber });
  },
  onReload: (callback) => {
    ipcRenderer.on('kiosk:reload', callback);
  },
});
```
