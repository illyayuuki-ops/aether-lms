TO:
```typescript
const SESSION_STORAGE_KEY = "kiosk_active_session";

const DEFAULT_WARNING_BEFORE_MS   = 60 * 1000;
const HEARTBEAT_INTERVAL_MS       = 10 * 1000;

export interface SessionResponse {
  sessionId: number;
  studentId: string;
  name: string;
  degree: string;
  yearLevel: string;
  computerNumber: number;
  researchTopic?: string | null;
  loginTime: string;
  inactivityLimitMinutes: number;  // ← Read from server response
  sessionTimeLimitMinutes: number; // ← Also read from server
  mustChangePassword?: boolean;
}

export function useKioskSession() {
  const [session, setSession] = useState<SessionResponse | null>(() => {
    try {
      const stored = localStorage.getItem(SESSION_STORAGE_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch {
      return null;
    }
  });

  // ← COMPUTE inactivity limit from session, not hardcoded
  const inactivityLimitMs = session
    ? (session.inactivityLimitMinutes || 10) * 60 * 1000
    : 10 * 60 * 1000;  // Fallback to 10 min if no session

  const sessionTimeLimitMs = session
    ? (session.sessionTimeLimitMinutes || 60) * 60 * 1000
    : 60 * 60 * 1000;  // Fallback to 60 min if no session
```

Then update the inactivity check logic (around line 120+):
```typescript
  // ── Inactivity Timer ──────────────────────────────────────────────────────
  useEffect(() => {
    if (!session) return;

    const interval = setInterval(() => {
      const now = Date.now();
      const inactiveMs = now - lastActivityRef.current;
      const elapsedMs = now - new Date(session.loginTime).getTime();

      // Check inactivity timeout
      if (inactiveMs > inactivityLimitMs) {
        handleLogout("inactivity");
        return;
      }

      // Check session time limit
      if (elapsedMs > sessionTimeLimitMs) {
        handleLogout("time_limit");
        return;
      }

      // Show warning before inactivity logout
      const warningThreshold = inactivityLimitMs - DEFAULT_WARNING_BEFORE_MS;
      if (inactiveMs > warningThreshold && !isWarningRef.current) {
        isWarningRef.current = true;
        setIsWarning(true);
        toast({
          title: "Session timeout warning",
          description: `You will be logged out in 1 minute due to inactivity.`,
        });
      }
    }, 1000);

    return () => clearInterval(interval);
  }, [session, inactivityLimitMs, sessionTimeLimitMs]);
