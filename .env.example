# ── Aether LMS environment ────────────────────────────────────────────────────
# Copy this file to `.env` (never commit `.env`) and fill in real values.

# Postgres connection string.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/aether_lms

# Port the API server listens on.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# REQUIRED in production. 32+ chars. Generate with: openssl rand -hex 32
JWT_SECRET=

# Initial super-admin account (used once, on an empty database).
# In production these are required; in development a random password is
# generated and printed to the console if they are absent.
MASTER_ADMIN_USERNAME=admin
MASTER_ADMIN_PASSWORD=

# Enables POST /api/admin/auth/first-setup. Leave blank to disable.
SETUP_CODE=

# Comma-separated list of allowed browser origins. Blank mirrors any origin
# (fine for a LAN deployment, tighten it if exposed).
CORS_ORIGINS=

# Optional: enables the AI insights panel on the analytics page.
ANTHROPIC_API_KEY=

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
